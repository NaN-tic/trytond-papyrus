<tryton>
  <data depends="account_invoice">
        <record model="ir.sequence" id="sequence_papyrus_account_invoice">
            <field name="name">Document Account Invoice</field>
            <field name="code">papyrus.page</field>
        </record>

        <record model="ir.ui.view" id="invoice_view_form">
            <field name="model">account.invoice</field>
            <field name="inherit" ref="account_invoice.invoice_view_form"/>
            <field name="name">invoice_form</field>
        </record>

        <record model="ir.action.report" id="report_account_invoice_papyrus">
            <field name="name">Barcode Document</field>
            <field name="model">account.invoice</field>
            <field name="report_name">account.invoice.papyrus</field>
            <field name="report">papyrus/papyrus.jrxml</field>
            <field name="extension">pdf</field>
            <field name="template_extension">jrxml</field>
        </record>
        <record model="ir.action.keyword" id="report_papyrus_account_invoice_keyword">
            <field name="keyword">form_print</field>
            <field name="model">account.invoice,-1</field>
            <field name="action" ref="report_account_invoice_papyrus"/>
        </record>
    </data>
</tryton>
