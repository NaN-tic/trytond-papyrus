<form col="6">
    <label name="number"/>
    <field name="number"/>
    <label name="reference"/>
    <field name="reference"/>
    <label name="queue"/>
    <field name="queue"/>
    <notebook colspan="6">
        <page name="image">
            <hpaned colspan="4">
                <child>
                    <field name="image" widget="image" height="700" width="550" colspan="2"/>
                    <group id="current_page" xfill="0" xexpand="0" col="3">
                        <button name="previous_page" xfill="0" xexpand="0" colspan="3"/>
                        <field name="current_page" xfill="0" xexpand="0"/>
                        <label string="/" id="/"/>
                        <field name="page_count" xfill="0" xexpand="0"/>
                        <button name="next_page" xfill="0" xexpand="0" colspan="3"/>
                    </group>
                </child>
            </hpaned>
        </page>
        <page name="text">
            <field name="text" colspan="4"/>
        </page>
        <page name="pages">
            <field name="pages" colspan="4"/>
        </page>
        <page string="Extra" id="extra">
            <label name="content"/>
            <field name="content"/>
            <label name="filename"/>
            <field name="filename"/>
        </page>
    </notebook>
    <group col="-1" colspan="6" id="buttons">
      <label name="state"/>
      <field name="state"/>
      <button name="process" icon="tryton-ok"/>
    </group>
</form>
