<form col="6">
    <label name="number"/>
    <field name="number"/>
    <label name="reference"/>
    <field name="reference"/>
    <label name="queue"/>
    <field name="queue"/>
    <notebook colspan="6">
        <page string="Image" id="image">
            <field name="data" widget="document" colspan="2" height="993"/>
            <group id="extra" colspan="2">
              <label name="company"/>
              <field name="company"/>
            </group>
        </page>
        <page name="text">
            <field name="text" colspan="4"/>
        </page>
        <page name="boxes">
            <field name="boxes" colspan="4"/>
        </page>
        <page name="pages">
            <field name="pages" colspan="4"/>
        </page>
        <page string="Extra" id="extra">
            <label name="data"/>
            <field name="data"/>
            <label name="filename"/>
            <field name="filename"/>
            <label name="origin"/>
            <field name="origin"/>
            <label name="employee"/>
            <field name="employee"/>
        </page>
    </notebook>
    <group col="-1" colspan="6" id="buttons">
      <label name="state"/>
      <field name="state"/>
      <button name="pending"/>
      <button name="inspect"/>
      <button name="reinspect"/>
      <button name="process"/>
      <button name="cancelled"/>
      <button name="split"/>
    </group>
</form>
