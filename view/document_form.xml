<form col="6">
    <label name="number"/>
    <field name="number"/>
    <label name="reference"/>
    <field name="reference"/>
    <label name="queue"/>
    <field name="queue"/>
    <notebook colspan="6">
        <page string="Image" id="image">
            <group colspan="2" id="image">
                <group id="current_page" xfill="0" xexpand="0" col="6" colspan="4">
                    <button name="previous_page" />
                    <field name="current_page" xfill="1" xexpand="0"/>
                    <label string="/" id="/"/>
                    <field name="page_count" xfill="0" xexpand="0"/>
                    <button name="next_page"/>
                </group>
                <field name="image" widget="image" readonly="1" height="-1" width="750" colspan="4"/>
            </group>
            <group id="extra" colspan="2">
              <label name="company"/>
              <field name="company"/>
            </group>
        </page>
        <page name="text">
            <field name="text" colspan="4"/>
        </page>
        <page name="boxes">
            <field name="boxes" colspan="4"/>
        </page>
        <page name="pages">
            <field name="pages" colspan="4"/>
        </page>
        <page string="Extra" id="extra">
            <label name="data"/>
            <field name="data"/>
            <label name="filename"/>
            <field name="filename"/>
            <label name="origin"/>
            <field name="origin"/>
            <label name="employee"/>
            <field name="employee"/>
        </page>
    </notebook>
    <group col="-1" colspan="6" id="buttons">
      <label name="state"/>
      <field name="state"/>
      <button name="pending"/>
      <button name="inspect"/>
      <button name="process"/>
      <button name="cancelled"/>
      <button name="split"/>
    </group>
</form>
