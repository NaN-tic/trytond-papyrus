<tryton>
    <data grouped="1">
        <record model="ir.message" id="cannot_save_file">
            <field name="text">Can not save "%(filename)s".</field>
        </record>
        <record model="ir.message" id="document_copy_forbidden">
            <field name="text">Papyrus Documents cannot be duplicated.</field>
        </record>
        <record model="ir.message" id="page_copy_forbidden">
            <field name="text">Papyrus Pages cannot be duplicated.</field>
        </record>
        <record model="ir.message" id="split_document_confirmation">
            <field name="text">Are you sure you want to split this document in "%(num_documents)s"? With the distribution "%(pages)s".</field>
        </record>
        <record model="ir.message" id="msg_missing_storage_directory">
            <field name="text">Storage directory "%(path)s" does not exist.</field>
        </record>
    </data>
</tryton>
