     copyright notices and license terms. -->
<tryton>
    <data>
        <record model="res.group" id="group_papyrus_admin">
            <field name="name">Papyrus Document Administration</field>
        </record>
        <record model="res.user-res.group" id="user_admin_group_papyrus_admin">
            <field name="user" ref="res.user_admin"/>
            <field name="group" ref="group_papyrus_admin"/>
        </record>
        <record model="res.user-res.group" id="user_trigger_group_papyrus_admin">
            <field name="user" ref="res.user_trigger"/>
            <field name="group" ref="group_papyrus_admin"/>
        </record>
        <record model="res.group" id="group_papyrus">
            <field name="name">Papyrus Document</field>
        </record>
        <record model="res.user-res.group" id="user_admin_group_papyrus">
            <field name="user" ref="res.user_admin"/>
            <field name="group" ref="group_papyrus"/>
        </record>
        <record model="res.user-res.group" id="user_trigger_group_papyrus">
            <field name="user" ref="res.user_trigger"/>
            <field name="group" ref="group_papyrus"/>
        </record>

        <record model="ir.sequence.type" id="sequence_type_papyrus_page">
            <field name="name">Document Page</field>
            <field name="code">papyrus.page</field>
        </record>
        <record model="ir.sequence.type-res.group" id="sequence_type_papyrus_page_group_admin">
            <field name="sequence_type" ref="sequence_type_papyrus_page"/>
            <field name="group" ref="res.group_admin"/>
        </record>
        <record model="ir.sequence.type-res.group" id="sequence_type_papyrus_page_group_document_admin">
            <field name="sequence_type" ref="sequence_type_papyrus_page"/>
            <field name="group" ref="group_papyrus_admin"/>
        </record>

        <!-- papyrus.queue -->
        <record model="ir.ui.view" id="papyrus_queue_view_form">
            <field name="model">papyrus.queue</field>
            <field name="type">form</field>
            <field name="name">document_queue_form</field>
        </record>
        <record model="ir.ui.view" id="papyrus_queue_view_list">
            <field name="model">papyrus.queue</field>
            <field name="type">tree</field>
            <field name="name">document_queue_list</field>
        </record>
        <record model="ir.action.act_window" id="act_papyrus_queue">
            <field name="name">Document Queue</field>
            <field name="res_model">papyrus.queue</field>
        </record>
        <record model="ir.action.act_window.view" id="act_papyrus_queue_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="papyrus_queue_view_list"/>
            <field name="act_window" ref="act_papyrus_queue"/>
        </record>
        <record model="ir.action.act_window.view" id="act_papyrus_queue_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="papyrus_queue_view_form"/>
            <field name="act_window" ref="act_papyrus_queue"/>
        </record>
        <record model="ir.model.access" id="access_papyrus_queue">
            <field name="model" search="[('model', '=', 'papyrus.queue')]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_papyrus_queue_admin">
            <field name="model" search="[('model', '=', 'papyrus.queue')]"/>
            <field name="group" ref="group_papyrus_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>

        <record model="ir.model.button" id="queue_process_button">
            <field name="name">process</field>
            <field name="string">Process</field>
            <field name="model" search="[('model', '=', 'papyrus.queue')]"/>
        </record>
        <record model="ir.model.button-res.group" id="queue_process_button_group_papyrus_admin">
            <field name="button" ref="queue_process_button"/>
            <field name="group" ref="group_papyrus_admin"/>
        </record>

        <!-- papyrus.document -->
        <record model="ir.ui.view" id="papyrus_document_view_form">
            <field name="model">papyrus.document</field>
            <field name="type">form</field>
            <field name="name">document_form</field>
        </record>
        <record model="ir.ui.view" id="papyrus_document_view_list">
            <field name="model">papyrus.document</field>
            <field name="type">tree</field>
            <field name="name">document_list</field>
        </record>
        <record model="ir.action.act_window" id="act_papyrus_document">
            <field name="name">Document</field>
            <field name="res_model">papyrus.document</field>
        </record>
        <record model="ir.action.act_window.view" id="act_papyrus_document_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="papyrus_document_view_list"/>
            <field name="act_window" ref="act_papyrus_document"/>
        </record>
        <record model="ir.action.act_window.view" id="act_papyrus_document_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="papyrus_document_view_form"/>
            <field name="act_window" ref="act_papyrus_document"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_document_form_domain_pending">
            <field name="name">Pending</field>
            <field name="sequence" eval="10"/>
            <field name="domain"
                eval="[('state', '=', 'pending')]"
                pyson="1"/>
            <field name="count" eval="True"/>
            <field name="act_window" ref="act_papyrus_document"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_document_form_domain_processed">
            <field name="name">Processed</field>
            <field name="sequence" eval="20"/>
            <field name="domain"
                eval="[('state', '=', 'processed')]"
                pyson="1"/>
            <field name="act_window" ref="act_papyrus_document"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_document_form_domain_all">
            <field name="name">All</field>
            <field name="sequence" eval="9999"/>
            <field name="domain"></field>
            <field name="act_window" ref="act_papyrus_document"/>
        </record>

        <record model="ir.action.act_window" id="act_document_pages">
            <field name="name">Pages</field>
            <field name="res_model">papyrus.page</field>
            <field name="domain"
                eval="[('document', '=', Eval('active_id'))]"
                pyson="1"/>
        </record>
        <record model="ir.action.keyword" id="keyword_document_pages">
            <field name="keyword">form_relate</field>
            <field name="model">papyrus.document,-1</field>
            <field name="action" ref="act_document_pages"/>
        </record>

        <record model="ir.model.access" id="access_papyrus">
            <field name="model" search="[('model', '=', 'papyrus.document')]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_papyrus_admin">
            <field name="model" search="[('model', '=', 'papyrus.document')]"/>
            <field name="group" ref="group_papyrus_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>

        <record model="ir.model.button" id="document_process_button">
            <field name="name">process</field>
            <field name="string">Process</field>
            <field name="model" search="[('model', '=', 'papyrus.document')]"/>
        </record>
        <record model="ir.model.button-res.group" id="document_process_button_group_papyrus_admin">
            <field name="button" ref="document_process_button"/>
            <field name="group" ref="group_papyrus_admin"/>
        </record>
        <record model="ir.model.button" id="document_next_page_button">
            <field name="name">next_page</field>
            <field name="string">Next Page</field>
            <field name="model" search="[('model', '=', 'papyrus.document')]"/>
        </record>
        <record model="ir.model.button-res.group" id="document_next_page_button_group_papyrus_admin">
            <field name="button" ref="document_next_page_button"/>
            <field name="group" ref="group_papyrus_admin"/>
        </record>
        <record model="ir.model.button" id="document_previous_page_button">
            <field name="name">previous_page</field>
            <field name="string">Previous Page</field>
            <field name="model" search="[('model', '=', 'papyrus.document')]"/>
        </record>
        <record model="ir.model.button-res.group" id="document_previous_page_button_group_papyrus_admin">
            <field name="button" ref="document_previous_page_button"/>
            <field name="group" ref="group_papyrus_admin"/>
        </record>

        <!-- papyrus.page -->
        <record model="ir.ui.view" id="papyrus_page_view_form">
            <field name="model">papyrus.page</field>
            <field name="type">form</field>
            <field name="name">document_page_form</field>
        </record>
        <record model="ir.ui.view" id="papyrus_page_view_list">
            <field name="model">papyrus.page</field>
            <field name="type">tree</field>
            <field name="name">document_page_list</field>
        </record>
        <record model="ir.action.act_window" id="act_papyrus_page">
            <field name="name">Document Page</field>
            <field name="res_model">papyrus.page</field>
        </record>
        <record model="ir.action.act_window.view" id="act_papyrus_page_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="papyrus_page_view_list"/>
            <field name="act_window" ref="act_papyrus_page"/>
        </record>
        <record model="ir.action.act_window.view" id="act_papyrus_page_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="papyrus_page_view_form"/>
            <field name="act_window" ref="act_papyrus_page"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_page_form_domain_pending">
            <field name="name">Pending</field>
            <field name="sequence" eval="10"/>
            <field name="domain"
                eval="[('state', '=', 'pending')]"
                pyson="1"/>
            <field name="count" eval="True"/>
            <field name="act_window" ref="act_papyrus_page"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_page_form_domain_processed">
            <field name="name">Processed</field>
            <field name="sequence" eval="20"/>
            <field name="domain"
                eval="[('state', '=', 'processed')]"
                pyson="1"/>
            <field name="act_window" ref="act_papyrus_page"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_page_form_domain_all">
            <field name="name">All</field>
            <field name="sequence" eval="9999"/>
            <field name="domain"></field>
            <field name="act_window" ref="act_papyrus_page"/>
        </record>

        <record model="ir.model.access" id="access_papyrus_page">
            <field name="model" search="[('model', '=', 'papyrus.page')]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_papyrus_page_admin">
            <field name="model" search="[('model', '=', 'papyrus.page')]"/>
            <field name="group" ref="group_papyrus_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>

        <record model="ir.model.button" id="page_process_button">
            <field name="name">process</field>
            <field name="string">Process</field>
            <field name="model" search="[('model', '=', 'papyrus.page')]"/>
        </record>
        <record model="ir.model.button-res.group" id="page_process_button_group_papyrus_admin">
            <field name="button" ref="page_process_button"/>
            <field name="group" ref="group_papyrus_admin"/>
        </record>

        <!-- Menus -->
        <menuitem id="menu_papyrus" name="Papyrus" sequence="1"/>
        <record model="ir.ui.menu-res.group" id="menu_papyrus_group_papyrus">
          <field name="menu" ref="menu_papyrus"/>
          <field name="group" ref="group_papyrus"/>
        </record>
        <record model="ir.ui.menu-res.group" id="menu_papyrus_group_papyrus_admin">
          <field name="menu" ref="menu_papyrus"/>
          <field name="group" ref="group_papyrus_admin"/>
        </record>

        <menuitem id="menu_papyrus_configuration" parent="menu_papyrus" name="Configuration" sequence="1"/>
        <record model="ir.ui.menu-res.group" id="menu_papyrus_configuration_group_papyrus_admin">
          <field name="menu" ref="menu_papyrus_configuration"/>
          <field name="group" ref="group_papyrus_admin"/>
        </record>

        <menuitem action="act_papyrus_queue" id="menu_papyrus_queue" parent="menu_papyrus_configuration" sequence="10" name="Queue"/>
        <menuitem action="act_papyrus_document" id="menu_papyrus_document" parent="menu_papyrus" sequence="10" name="Documents"/>
        <menuitem action="act_papyrus_page" id="menu_papyrus_page" parent="menu_papyrus_document" sequence="10" name="Pages"/>

        <!-- Cron -->
        <record model="ir.cron" id="cron_papyrus_import_pages">
            <field name="name">Papyrus Document Queue</field>
            <field name="request_user" ref="res.user_admin"/>
            <field name="user" ref="res.user_trigger"/>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="number_calls">-1</field>
            <field name="repeat_missed" eval="False"/>
            <field name="model">papyrus.queue</field>
            <field name="function">import_pages</field>
        </record>

        <record model="ir.cron" id="cron_papyrus_attach_documents">
            <field name="name">Papyrus Attach Documents</field>
            <field name="request_user" ref="res.user_admin"/>
            <field name="user" ref="res.user_trigger"/>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="number_calls">-1</field>
            <field name="repeat_missed" eval="False"/>
            <field name="model">papyrus.document</field>
            <field name="function">attach_documents</field>
        </record>

        <record model="ir.cron" id="cron_papyrus_create_document">
            <field name="name">Papyrus Create Documents</field>
            <field name="request_user" ref="res.user_admin"/>
            <field name="user" ref="res.user_trigger"/>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="number_calls">-1</field>
            <field name="repeat_missed" eval="False"/>
            <field name="model">papyrus.page</field>
            <field name="function">create_documents</field>
        </record>
    </data>
</tryton>
