<tryton>
  <data depends="purchase">
        <record model="ir.ui.view" id="purchase_view_form">
            <field name="model">purchase.purchase</field>
            <field name="inherit" ref="purchase.purchase_view_form"/>
            <field name="name">purchase_form</field>
        </record>
        <record model="ir.model.button" id="purchase_papyrus_barcode_button">
            <field name="name">papyrus_barcode</field>
            <field name="string">Papyrus Barcode</field>
            <field name="help">Prints a barcode that can be stick to the paper and later process the document using Papyrus</field>
            <field name="model" search="[('model', '=', 'purchase.purchase')]"/>
        </record>

        <record model="ir.action.report" id="report_purchase_papyrus">
            <field name="name">Papyrus Barcode</field>
            <field name="model">purchase.purchase</field>
            <field name="report_name">purchase.papyrus</field>
            <field name="report">papyrus/papyrus.jrxml</field>
            <field name="extension">pdf</field>
            <field name="template_extension">jrxml</field>
        </record>
        <record model="ir.action.keyword" id="report_papyrus_purchase_keyword">
            <field name="keyword">form_print</field>
            <field name="model">purchase.purchase,-1</field>
            <field name="action" ref="report_purchase_papyrus"/>
        </record>
    </data>
</tryton>
