<data>
    <xpath expr="/form/field" position="replace">
        <group id="image" col="1">
            <field name="image" widget="image" height="350" width="275" readonly="1"/>
            <group id="current_page" xfill="0" xexpand="0" col="6">
                <button name="previous_page" />
                <field name="current_page" xfill="1" xexpand="0"/>
                <label string="/" id="/"/>
                <field name="page_count" xfill="0" xexpand="0"/>
                <button name="next_page"/>
                <field name="file_id" invisible="1" colspan="6"/>
            </group>
        </group>
    </xpath>
    <xpath expr="/form/notebook" position="inside">
        <page name="content">
            <field name="content" colspan="4"/>
        </page>
    </xpath>
</data>
